# Required when starting the backend. Replace these placeholders privately.
DO_MODEL_KEY=replace-with-digitalocean-inference-key
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/nene
NENE_API_TOKEN=replace-with-a-long-random-token

# Required only for deploying generated projects to Render.
RENDER_API_KEY=replace-with-render-api-key
RENDER_OWNER_ID=replace-with-render-owner-id
RENDER_REGION=oregon
